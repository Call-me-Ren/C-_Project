@page "/quan-ly-dau-sach"
@using QLThuVien.Web.Data
@rendermode InteractiveServer
@inject TraCuuSachService SachService
@inject ThuVienWebService WebService

<PageTitle>Quản lý Đầu sách - Thư viện SGU</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                </svg>
                Quản lý Đầu sách
            </h1>
            <p class="page-subtitle">Thêm, sửa, xóa và theo dõi tồn kho đầu sách đồng bộ với phần mềm WinForms</p>
        </div>
        <span class="badge-soft badge-soft-primary px-3 py-2">
            Tổng: <strong class="num-tabular">@danhSach.Count</strong> đầu sách
        </span>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(laLoi ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert">
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    <div class="app-card mb-4">
        <div class="app-card-header">
            <span>@(dangSua ? $"Chỉnh sửa Đầu sách: {formModel.MaDauSach}" : "Thêm Đầu sách mới")</span>
            @if (dangSua)
            {
                <span class="badge-soft badge-soft-warning">Đang chỉnh sửa</span>
            }
        </div>
        <div class="app-card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Mã đầu sách</label>
                    <input class="form-control" @bind="formModel.MaDauSach" disabled="@dangSua" placeholder="VD: DS04" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Tên sách</label>
                    <input class="form-control" @bind="formModel.TenSach" placeholder="Nhập tên sách..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Năm XB</label>
                    <input type="number" class="form-control" @bind="formModel.NamXB" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Đơn giá (VNĐ)</label>
                    <input type="number" class="form-control" @bind="formModel.DonGia" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tác giả</label>
                    <select class="form-select" @bind="formModel.MaTG">
                        @foreach (var tg in dsTacGia)
                        {
                            <option value="@tg.Ma">@tg.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Thể loại</label>
                    <select class="form-select" @bind="formModel.MaTL">
                        @foreach (var tl in dsTheLoai)
                        {
                            <option value="@tl.Ma">@tl.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nhà xuất bản</label>
                    <select class="form-select" @bind="formModel.MaNXB">
                        @foreach (var nxb in dsNXB)
                        {
                            <option value="@nxb.Ma">@nxb.Ten</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                @if (dangSua)
                {
                    <button class="btn btn-primary" @onclick="LuuCapNhat">Lưu cập nhật</button>
                    <button class="btn btn-outline-secondary" @onclick="LamMoiForm">Hủy sửa</button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="ThemMoi">Thêm đầu sách</button>
                    <button class="btn btn-outline-secondary" @onclick="LamMoiForm">Làm mới</button>
                }
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-body pb-0">
            <div class="input-group mb-3">
                <input class="form-control" placeholder="Tìm theo mã, tên sách, tác giả, thể loại..."
                       @bind="tuKhoa" @bind:event="oninput" />
                <button class="btn btn-primary" @onclick="TaiDuLieu">Tìm kiếm</button>
                <button class="btn btn-outline-secondary" @onclick="() => { tuKhoa = string.Empty; TaiDuLieu(); }">Tất cả</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table app-table align-middle">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên sách</th>
                        <th>Tác giả</th>
                        <th>Thể loại</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-center">Tồn / Tổng</th>
                        <th class="text-end text-nowrap" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in danhSach)
                    {
                        <tr>
                            <td><span class="badge-soft badge-soft-neutral">@item.MaDauSach</span></td>
                            <td class="fw-semibold text-dark">@item.TenSach</td>
                            <td class="text-secondary">@item.TenTacGia</td>
                            <td><span class="badge-soft badge-soft-primary">@item.TenTheLoai</span></td>
                            <td class="text-end num-tabular">@item.DonGia.ToString("N0") đ</td>
                            <td class="text-center num-tabular">
                                <span class="fw-semibold">@item.SLConLai</span>
                                <span class="text-muted">/ @item.SoLuong</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-soft-primary me-1" @onclick="() => ChonSua(item.MaDauSach)">Sửa</button>
                                <button class="btn btn-sm btn-soft-danger" @onclick="() => Xoa(item.MaDauSach)">Xóa</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<DauSachTraCuu> danhSach = new();
    private List<LookupItemWeb> dsTacGia = new();
    private List<LookupItemWeb> dsTheLoai = new();
    private List<LookupItemWeb> dsNXB = new();
    private DauSachEditModel formModel = new();
    private string tuKhoa = string.Empty;
    private bool dangSua = false;
    private string thongBao = string.Empty;
    private bool laLoi = false;

    protected override void OnInitialized()
    {
        try
        {
            dsTacGia = WebService.LayDanhMuc("TacGia");
            dsTheLoai = WebService.LayDanhMuc("TheLoai");
            dsNXB = WebService.LayDanhMuc("NXB");
            LamMoiForm();
            TaiDuLieu();
        }
        catch (Exception ex)
        {
            DatThongBao(false, "Lỗi kết nối CSDL: " + ex.Message);
        }
    }

    private void TaiDuLieu()
    {
        danhSach = SachService.LayDanhSachDauSach(tuKhoa);
    }

    private void ThemMoi()
    {
        try
        {
            var res = WebService.ThemDauSach(formModel);
            DatThongBao(res.ok, res.message);
            if (res.ok)
            {
                LamMoiForm();
                TaiDuLieu();
            }
        }
        catch (Exception ex)
        {
            DatThongBao(false, ex.Message);
        }
    }

    private void ChonSua(string maDauSach)
    {
        try
        {
            var found = WebService.LayDauSachTheoMa(maDauSach);
            if (found != null)
            {
                formModel = found;
                dangSua = true;
            }
        }
        catch (Exception ex)
        {
            DatThongBao(false, ex.Message);
        }
    }

    private void LuuCapNhat()
    {
        try
        {
            var res = WebService.SuaDauSach(formModel);
            DatThongBao(res.ok, res.message);
            if (res.ok)
            {
                LamMoiForm();
                TaiDuLieu();
            }
        }
        catch (Exception ex)
        {
            DatThongBao(false, ex.Message);
        }
    }

    private void Xoa(string maDauSach)
    {
        try
        {
            var res = WebService.XoaDauSach(maDauSach);
            DatThongBao(res.ok, res.message);
            if (res.ok) TaiDuLieu();
        }
        catch (Exception ex)
        {
            DatThongBao(false, ex.Message);
        }
    }

    private void LamMoiForm()
    {
        formModel = new DauSachEditModel
        {
            MaTG = dsTacGia.FirstOrDefault()?.Ma ?? string.Empty,
            MaTL = dsTheLoai.FirstOrDefault()?.Ma ?? string.Empty,
            MaNXB = dsNXB.FirstOrDefault()?.Ma ?? string.Empty,
            NamXB = DateTime.Now.Year
        };
        dangSua = false;
    }

    private void DatThongBao(bool ok, string msg)
    {
        laLoi = !ok;
        thongBao = msg;
    }
}
