@page "/"
@using QLThuVien.Web.Data
@rendermode InteractiveServer
@inject TraCuuSachService SachService

<PageTitle>Tra cứu Đầu sách - Thư viện Đại học Sài Gòn</PageTitle>

<div class="container py-4">
    <!-- Header banner -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #2980b9, #2c3e50);">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="fw-bold mb-1">📚 HỆ THỐNG TRA CỨU SÁCH TRỰC TUYẾN</h2>
                <p class="mb-0 opacity-75">Thư viện Trung tâm — Dành cho Sinh viên & Giảng viên</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <span class="badge bg-light text-dark px-3 py-2 fs-6">
                    Tổng số: <strong>@danhSach.Count</strong> đầu sách
                </span>
            </div>
        </div>
    </div>

    <!-- Thanh tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">🔍</span>
                        <input type="text" class="form-control border-start-0" 
                               placeholder="Nhập tên sách, tác giả, thể loại cần tìm..."
                               @bind="tuKhoa" @bind:event="oninput" @onkeyup="XuLyTimKiem" />
                    </div>
                </div>
                <div class="col-md-3 d-grid gap-2 d-md-flex">
                    <button class="btn btn-primary flex-grow-1" @onclick="TimKiem">Tìm kiếm</button>
                    <button class="btn btn-outline-secondary" @onclick="LamMoi">Làm mới</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê nhanh trạng thái -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-primary border-4">
                <div class="card-body py-2">
                    <small class="text-muted">Tổng số đầu sách</small>
                    <h4 class="mb-0 text-primary fw-bold">@danhSach.Count</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-success border-4">
                <div class="card-body py-2">
                    <small class="text-muted">Đang có sẵn để mượn</small>
                    <h4 class="mb-0 text-success fw-bold">@danhSach.Count(s => s.ConSach)</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-danger border-4">
                <div class="card-body py-2">
                    <small class="text-muted">Tạm thời hết sách</small>
                    <h4 class="mb-0 text-danger fw-bold">@danhSach.Count(s => !s.ConSach)</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách sách -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-secondary">DANH MỤC ĐẦU SÁCH HIỆN CÓ</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Mã sách</th>
                        <th>Tên đầu sách</th>
                        <th>Thể loại</th>
                        <th>Tác giả</th>
                        <th>Nhà xuất bản</th>
                        <th class="text-center">Năm XB</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-center" style="width: 160px;">Tình trạng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (danhSach.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <em>Không tìm thấy đầu sách nào phù hợp với từ khóa "@tuKhoa"</em>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in danhSach)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@s.MaDauSach</span></td>
                                <td class="fw-bold text-primary">@s.TenSach</td>
                                <td><span class="badge bg-info text-dark">@s.TenTheLoai</span></td>
                                <td>@s.TenTacGia</td>
                                <td><small class="text-muted">@s.TenNXB</small></td>
                                <td class="text-center">@(s.NamXB > 0 ? s.NamXB.ToString() : "-")</td>
                                <td class="text-center">
                                    <span class="fw-semibold">@s.SLConLai</span> / <span class="text-muted">@s.SoLuong</span>
                                </td>
                                <td class="text-center">
                                    @if (s.ConSach)
                                    {
                                        <span class="badge bg-success px-2 py-1">✓ Còn @s.SLConLai cuốn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-2 py-1">✕ Đang mượn hết</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string tuKhoa = string.Empty;
    private List<DauSachTraCuu> danhSach = new();

    protected override void OnInitialized()
    {
        TaiDuLieu();
    }

    private void TaiDuLieu()
    {
        danhSach = SachService.LayDanhSachDauSach(tuKhoa);
    }

    private void TimKiem()
    {
        TaiDuLieu();
    }

    private void XuLyTimKiem(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            TaiDuLieu();
        }
    }

    private void LamMoi()
    {
        tuKhoa = string.Empty;
        TaiDuLieu();
    }
}
