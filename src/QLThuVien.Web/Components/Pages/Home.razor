@page "/"
@using QLThuVien.Web.Data
@rendermode InteractiveServer
@inject TraCuuSachService SachService

<PageTitle>Tra cứu Đầu sách - Thư viện Đại học Sài Gòn</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                </svg>
                Tra cứu Đầu sách Trực tuyến
            </h1>
            <p class="page-subtitle">Thư viện Trung tâm — Dành cho Sinh viên &amp; Giảng viên</p>
        </div>
        <span class="badge-soft badge-soft-primary px-3 py-2">
            Tổng số: <strong class="num-tabular">@danhSach.Count</strong> đầu sách
        </span>
    </div>

    <div class="app-card mb-4">
        <div class="app-card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="8" />
                                <path d="m21 21-4.3-4.3" />
                            </svg>
                        </span>
                        <input type="text" class="form-control border-start-0"
                               placeholder="Nhập tên sách, tác giả, thể loại cần tìm..."
                               @bind="tuKhoa" @bind:event="oninput" @onkeyup="XuLyTimKiem" />
                    </div>
                </div>
                <div class="col-md-3 d-grid gap-2 d-md-flex">
                    <button class="btn btn-primary flex-grow-1" @onclick="TimKiem">Tìm kiếm</button>
                    <button class="btn btn-outline-secondary" @onclick="LamMoi">Làm mới</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Tổng số đầu sách</div>
                    <h4 class="stat-value text-primary">@danhSach.Count</h4>
                </div>
                <div class="stat-icon" style="background-color: #EFF6FF; color: #2563EB;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                    </svg>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Đang có sẵn để mượn</div>
                    <h4 class="stat-value" style="color: #15803D;">@danhSach.Count(s => s.ConSach)</h4>
                </div>
                <div class="stat-icon" style="background-color: #DCFCE7; color: #15803D;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Tạm thời hết sách</div>
                    <h4 class="stat-value" style="color: #B91C1C;">@danhSach.Count(s => !s.ConSach)</h4>
                </div>
                <div class="stat-icon" style="background-color: #FEE2E2; color: #B91C1C;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="15" y1="9" x2="9" y2="15" />
                        <line x1="9" y1="9" x2="15" y2="15" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-header">
            <span>Danh mục Đầu sách hiện có</span>
            <span class="text-muted small fw-normal num-tabular">@danhSach.Count kết quả</span>
        </div>
        <div class="table-responsive">
            <table class="table app-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 100px;">Mã sách</th>
                        <th>Tên đầu sách</th>
                        <th>Thể loại</th>
                        <th>Tác giả</th>
                        <th>Nhà xuất bản</th>
                        <th class="text-center">Năm XB</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-center" style="width: 165px;">Tình trạng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (danhSach.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Không tìm thấy đầu sách nào phù hợp với từ khóa "@tuKhoa"
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in danhSach)
                        {
                            <tr>
                                <td><span class="badge-soft badge-soft-neutral">@s.MaDauSach</span></td>
                                <td class="fw-semibold text-dark">@s.TenSach</td>
                                <td><span class="badge-soft badge-soft-primary">@s.TenTheLoai</span></td>
                                <td class="text-secondary">@s.TenTacGia</td>
                                <td class="text-muted small">@s.TenNXB</td>
                                <td class="text-center num-tabular">@(s.NamXB > 0 ? s.NamXB.ToString() : "-")</td>
                                <td class="text-center num-tabular">
                                    <span class="fw-semibold text-dark">@s.SLConLai</span>
                                    <span class="text-muted">/ @s.SoLuong</span>
                                </td>
                                <td class="text-center">
                                    @if (s.ConSach)
                                    {
                                        <span class="badge-soft badge-soft-success">Còn @s.SLConLai cuốn</span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft badge-soft-danger">Đang mượn hết</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string tuKhoa = string.Empty;
    private List<DauSachTraCuu> danhSach = new();

    protected override void OnInitialized()
    {
        TaiDuLieu();
    }

    private void TaiDuLieu()
    {
        danhSach = SachService.LayDanhSachDauSach(tuKhoa);
    }

    private void TimKiem()
    {
        TaiDuLieu();
    }

    private void XuLyTimKiem(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            TaiDuLieu();
        }
    }

    private void LamMoi()
    {
        tuKhoa = string.Empty;
        TaiDuLieu();
    }
}
