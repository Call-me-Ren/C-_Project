@page "/duyet-muon-sach"
@using QLThuVien.Web.Data
@rendermode InteractiveServer
@inject ThuVienWebService WebService

<PageTitle>Admin Duyệt mượn sách - Thư viện SGU</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 11l3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                </svg>
                Xác nhận &amp; Duyệt Yêu cầu Mượn
            </h1>
            <p class="page-subtitle">Khi duyệt, hệ thống tự động lập Phiếu mượn trong SQL Server và trừ tồn kho Đầu sách</p>
        </div>
        <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" @onclick="TaiDuLieu">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                <path d="M3 3v5h5" />
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
                <path d="M16 16h5v5" />
            </svg>
            Tải lại
        </button>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(laLoi ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert">
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    <div class="app-card mb-4">
        <div class="app-card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <label class="form-label mb-0 text-nowrap">Thủ thư duyệt phiếu:</label>
                <select class="form-select w-auto" @bind="maNhanVien">
                    @foreach (var nv in dsNhanVien)
                    {
                        <option value="@nv.Ma">@nv.Ten</option>
                    }
                </select>
            </div>
            <span class="badge-soft badge-soft-warning">
                Chờ duyệt: <strong class="num-tabular">@dsYeuCau.Count(x => x.TrangThai == "Chờ duyệt")</strong>
            </span>
        </div>
    </div>

    <div class="app-card">
        <div class="table-responsive">
            <table class="table app-table align-middle">
                <thead>
                    <tr>
                        <th>Mã YC</th>
                        <th>Ngày gửi</th>
                        <th>Độc giả</th>
                        <th>Đầu sách</th>
                        <th>Ghi chú</th>
                        <th>Trạng thái</th>
                        <th>Mã PM</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dsYeuCau.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">Hiện chưa có yêu cầu đặt mượn nào cần xử lý.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var yc in dsYeuCau)
                        {
                            <tr>
                                <td><span class="badge-soft badge-soft-neutral">@yc.MaYeuCau</span></td>
                                <td class="num-tabular text-muted small">@yc.NgayYeuCau.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@yc.MaDocGia - @yc.TenDocGia</td>
                                <td class="fw-semibold text-dark">@yc.TenSach</td>
                                <td class="text-muted small">@yc.GhiChu</td>
                                <td>
                                    @if (yc.TrangThai == "Đã duyệt")
                                    {
                                        <span class="badge-soft badge-soft-success">@yc.TrangThai</span>
                                    }
                                    else if (yc.TrangThai == "Đã từ chối")
                                    {
                                        <span class="badge-soft badge-soft-danger">@yc.TrangThai</span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft badge-soft-warning">@yc.TrangThai</span>
                                    }
                                </td>
                                <td class="num-tabular">@(string.IsNullOrEmpty(yc.MaPMDaTao) ? "-" : yc.MaPMDaTao)</td>
                                <td class="text-end text-nowrap">
                                    @if (yc.TrangThai == "Chờ duyệt")
                                    {
                                        <button class="btn btn-sm btn-soft-success me-1" @onclick="() => Duyet(yc.MaYeuCau)">Duyệt</button>
                                        <button class="btn btn-sm btn-soft-danger" @onclick="() => TuChoi(yc.MaYeuCau)">Từ chối</button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Đã xử lý</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<YeuCauMuonWeb> dsYeuCau = new();
    private List<LookupItemWeb> dsNhanVien = new();
    private string maNhanVien = string.Empty;
    private string thongBao = string.Empty;
    private bool laLoi = false;

    protected override void OnInitialized() => TaiDuLieu();

    private void TaiDuLieu()
    {
        try
        {
            dsNhanVien = WebService.LayDanhMuc("NhanVien");
            if (string.IsNullOrEmpty(maNhanVien)) maNhanVien = dsNhanVien.FirstOrDefault()?.Ma ?? string.Empty;
            dsYeuCau = WebService.LayDanhSachYeuCauMuon();
        }
        catch (Exception ex)
        {
            laLoi = true;
            thongBao = "Lỗi tải dữ liệu: " + ex.Message;
        }
    }

    private void Duyet(string maYC)
    {
        var res = WebService.DuyetYeuCauMuon(maYC, maNhanVien);
        laLoi = !res.ok;
        thongBao = res.message;
        TaiDuLieu();
    }

    private void TuChoi(string maYC)
    {
        var res = WebService.TuChoiYeuCauMuon(maYC);
        laLoi = !res.ok;
        thongBao = res.message;
        TaiDuLieu();
    }
}
