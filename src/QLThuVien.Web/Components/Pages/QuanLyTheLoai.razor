@page "/quan-ly-the-loai"
@using QLThuVien.Web.Data
@rendermode InteractiveServer
@inject ThuVienWebService WebService

<PageTitle>Quản lý Thể loại - Thư viện SGU</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 7h-9" />
                    <path d="M14 17H5" />
                    <circle cx="17" cy="17" r="3" />
                    <circle cx="7" cy="7" r="3" />
                </svg>
                Quản lý Thể loại Sách
            </h1>
            <p class="page-subtitle">Thêm, sửa, xóa và tìm kiếm danh mục thể loại trực tiếp trên SQL Server</p>
        </div>
        <span class="badge-soft badge-soft-primary px-3 py-2">
            Tổng: <strong class="num-tabular">@danhSach.Count</strong> thể loại
        </span>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(laLoi ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert">
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="app-card">
                <div class="app-card-header">
                    <span>@(dangSua ? "Cập nhật Thể loại" : "Thêm Thể loại mới")</span>
                    @if (dangSua)
                    {
                        <span class="badge-soft badge-soft-warning">Đang sửa</span>
                    }
                </div>
                <div class="app-card-body">
                    <div class="mb-3">
                        <label class="form-label">Mã thể loại</label>
                        <input type="text" class="form-control" @bind="formModel.MaTL" disabled="@dangSua" placeholder="VD: TL04" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tên thể loại</label>
                        <input type="text" class="form-control" @bind="formModel.TenTL" placeholder="Nhập tên thể loại..." />
                    </div>
                    <div class="d-grid gap-2">
                        @if (dangSua)
                        {
                            <button class="btn btn-primary" @onclick="LuuCapNhat">Lưu cập nhật</button>
                            <button class="btn btn-outline-secondary" @onclick="LamMoiForm">Hủy chọn</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="ThemMoi">Thêm thể loại</button>
                            <button class="btn btn-outline-secondary" @onclick="LamMoiForm">Làm mới</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="app-card">
                <div class="app-card-body pb-0">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Tìm theo mã hoặc tên thể loại..."
                               @bind="tuKhoa" @bind:event="oninput" @onkeyup="XuLyPhimTim" />
                        <button class="btn btn-primary" @onclick="TaiDuLieu">Tìm kiếm</button>
                        <button class="btn btn-outline-secondary" @onclick="XoaBoLoc">Tất cả</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table app-table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 140px;">Mã thể loại</th>
                                <th>Tên thể loại</th>
                                <th class="text-end" style="width: 160px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (danhSach.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-5">Không tìm thấy thể loại nào.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in danhSach)
                                {
                                    <tr>
                                        <td><span class="badge-soft badge-soft-neutral">@item.MaTL</span></td>
                                        <td class="fw-semibold text-dark">@item.TenTL</td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-sm btn-soft-primary me-1" @onclick="() => ChonSua(item)">Sửa</button>
                                            <button class="btn btn-sm btn-soft-danger" @onclick="() => Xoa(item.MaTL)">Xóa</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TheLoaiWebModel> danhSach = new();
    private TheLoaiWebModel formModel = new();
    private string tuKhoa = string.Empty;
    private bool dangSua = false;
    private string thongBao = string.Empty;
    private bool laLoi = false;

    protected override void OnInitialized() => TaiDuLieu();

    private void TaiDuLieu()
    {
        try
        {
            danhSach = WebService.LayDanhSachTheLoai(tuKhoa);
        }
        catch (Exception ex)
        {
            DatThongBao(false, "Lỗi tải dữ liệu: " + ex.Message);
        }
    }

    private void ThemMoi()
    {
        try
        {
            var res = WebService.ThemTheLoai(formModel);
            DatThongBao(res.ok, res.message);
            if (res.ok)
            {
                LamMoiForm();
                TaiDuLieu();
            }
        }
        catch (Exception ex)
        {
            DatThongBao(false, ex.Message);
        }
    }

    private void ChonSua(TheLoaiWebModel item)
    {
        formModel = new TheLoaiWebModel { MaTL = item.MaTL, TenTL = item.TenTL };
        dangSua = true;
    }

    private void LuuCapNhat()
    {
        try
        {
            var res = WebService.SuaTheLoai(formModel);
            DatThongBao(res.ok, res.message);
            if (res.ok)
            {
                LamMoiForm();
                TaiDuLieu();
            }
        }
        catch (Exception ex)
        {
            DatThongBao(false, ex.Message);
        }
    }

    private void Xoa(string maTL)
    {
        try
        {
            var res = WebService.XoaTheLoai(maTL);
            DatThongBao(res.ok, res.message);
            if (res.ok)
            {
                if (dangSua && formModel.MaTL == maTL) LamMoiForm();
                TaiDuLieu();
            }
        }
        catch (Exception ex)
        {
            DatThongBao(false, ex.Message);
        }
    }

    private void LamMoiForm()
    {
        formModel = new TheLoaiWebModel();
        dangSua = false;
    }

    private void XoaBoLoc()
    {
        tuKhoa = string.Empty;
        TaiDuLieu();
    }

    private void XuLyPhimTim(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") TaiDuLieu();
    }

    private void DatThongBao(bool ok, string msg)
    {
        laLoi = !ok;
        thongBao = msg;
    }
}
