@page "/dat-muon-sach"
@using QLThuVien.Web.Data
@rendermode InteractiveServer
@inject TraCuuSachService SachService
@inject ThuVienWebService WebService

<PageTitle>Đặt mượn sách - Thư viện SGU</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                </svg>
                Đặt mượn Sách Trực tuyến
            </h1>
            <p class="page-subtitle">Độc giả gửi yêu cầu mượn sách — Thủ thư sẽ xác nhận duyệt và cấp Phiếu mượn</p>
        </div>
        <span class="badge-soft badge-soft-primary px-3 py-2">
            Đã gửi: <strong class="num-tabular">@dsYeuCau.Count</strong> yêu cầu
        </span>
    </div>

    @if (!string.IsNullOrEmpty(thongBao))
    {
        <div class="alert @(laLoi ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert">
            @thongBao
            <button type="button" class="btn-close" @onclick="() => thongBao = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="app-card">
                <div class="app-card-header">Phiếu đăng ký đặt mượn</div>
                <div class="app-card-body">
                    <div class="mb-3">
                        <label class="form-label">Độc giả</label>
                        <select class="form-select" @bind="maDocGia">
                            @foreach (var dg in dsDocGia)
                            {
                                <option value="@dg.Ma">@dg.Ten</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Đầu sách còn sẵn</label>
                        <select class="form-select" @bind="maDauSach">
                            @foreach (var s in dsSachCon)
                            {
                                <option value="@s.MaDauSach">@s.MaDauSach - @s.TenSach (Còn @s.SLConLai cuốn)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ghi chú nhận sách</label>
                        <textarea class="form-control" rows="2" @bind="ghiChu" placeholder="VD: Nhận sách vào chiều thứ 5..."></textarea>
                    </div>
                    <button class="btn btn-primary w-100" @onclick="GuiYeuCau">
                        Gửi yêu cầu đặt mượn
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="app-card">
                <div class="app-card-header">
                    <span>Danh sách yêu cầu đã gửi</span>
                    <span class="text-muted small fw-normal num-tabular">@dsYeuCau.Count mục</span>
                </div>
                <div class="table-responsive">
                    <table class="table app-table align-middle">
                        <thead>
                            <tr>
                                <th>Mã YC</th>
                                <th>Độc giả</th>
                                <th>Sách yêu cầu</th>
                                <th>Trạng thái</th>
                                <th>Phiếu mượn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (dsYeuCau.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5">Chưa có yêu cầu đặt mượn nào.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var yc in dsYeuCau)
                                {
                                    <tr>
                                        <td><span class="badge-soft badge-soft-neutral">@yc.MaYeuCau</span></td>
                                        <td>@yc.MaDocGia - @yc.TenDocGia</td>
                                        <td class="fw-semibold text-dark">@yc.TenSach</td>
                                        <td>
                                            @if (yc.TrangThai == "Đã duyệt")
                                            {
                                                <span class="badge-soft badge-soft-success">@yc.TrangThai</span>
                                            }
                                            else if (yc.TrangThai == "Đã từ chối")
                                            {
                                                <span class="badge-soft badge-soft-danger">@yc.TrangThai</span>
                                            }
                                            else
                                            {
                                                <span class="badge-soft badge-soft-warning">@yc.TrangThai</span>
                                            }
                                        </td>
                                        <td class="num-tabular">@(string.IsNullOrEmpty(yc.MaPMDaTao) ? "-" : yc.MaPMDaTao)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<LookupItemWeb> dsDocGia = new();
    private List<DauSachTraCuu> dsSachCon = new();
    private List<YeuCauMuonWeb> dsYeuCau = new();
    private string maDocGia = string.Empty;
    private string maDauSach = string.Empty;
    private string ghiChu = string.Empty;
    private string thongBao = string.Empty;
    private bool laLoi = false;

    protected override void OnInitialized() => TaiDuLieu();

    private void TaiDuLieu()
    {
        try
        {
            dsDocGia = WebService.LayDanhMuc("DocGia");
            dsSachCon = SachService.LayDanhSachDauSach().Where(x => x.ConSach).ToList();
            dsYeuCau = WebService.LayDanhSachYeuCauMuon();
            if (string.IsNullOrEmpty(maDocGia)) maDocGia = dsDocGia.FirstOrDefault()?.Ma ?? string.Empty;
            if (string.IsNullOrEmpty(maDauSach)) maDauSach = dsSachCon.FirstOrDefault()?.MaDauSach ?? string.Empty;
        }
        catch (Exception ex)
        {
            laLoi = true;
            thongBao = "Lỗi tải dữ liệu: " + ex.Message;
        }
    }

    private void GuiYeuCau()
    {
        var res = WebService.GuiYeuCauMuon(maDocGia, maDauSach, ghiChu);
        laLoi = !res.ok;
        thongBao = res.message;
        if (res.ok)
        {
            ghiChu = string.Empty;
            TaiDuLieu();
        }
    }
}
